{
  "name": "titan-stay",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:auth": "turbo run test:auth",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @titan/db run migrate",
    "gate": "turbo run lint typecheck test"
  },
  "devDependencies": {
    "turbo": "2.10.7",
    "typescript": "^5.7.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "@types/node": "^22.10.2"
  }
}
